# Copy to .env and fill in. .env is gitignored; never commit real values.
# Next.js loads .env files from the project ROOT (not from src/).

# ---------------------------------------------------------------------------
# Database — required
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string. MUST include a database name path segment:
# without one the driver silently falls back to a database called "test".
# Named MONGO_URI (not MONGODB_URI) to match the key this project already uses.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/sendly?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Authentication — required
# ---------------------------------------------------------------------------
# Signs session cookies. Minimum 32 characters; better-auth refuses to start in
# production with its built-in default. Generate one with:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# Absolute base URL of this deployment. Used for cookie security decisions and
# auth callback URLs. http://localhost:3000 in development; the real origin in
# production (e.g. https://sendly.example.com).
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Image hosting (Cloudinary) — optional
# ---------------------------------------------------------------------------
# Leave both unset and the application runs normally; only the shipment photo
# upload on the create form is unavailable, and it reports that as a field error.
#
# Signing credential for server-side uploads. Holds an API SECRET: it is read
# only by src/lib/cloudinary.ts and never reaches the browser. Copy it verbatim
# from the Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# The cloud name again, this time for the browser: next-cloudinary's <CldImage>
# builds delivery URLs client-side, and NEXT_PUBLIC_* is inlined at BUILD time,
# so it cannot be derived from the server-only CLOUDINARY_URL above.
# Not a secret — it appears in every res.cloudinary.com URL. It MUST match the
# cloud name in CLOUDINARY_URL; lib/cloudinary.ts refuses an upload if it does
# not, because uploading to one cloud while the browser reads from another would
# 404 every image.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=CLOUD_NAME

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# debug | info | warn | error. Defaults to debug in development, info in production.
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Seed-only — read by `npm run db:seed-admin`, never by the web application
# ---------------------------------------------------------------------------
# There is no public sign-up. The first administrator is created by the seed
# script, which is idempotent and safe to re-run.
ADMIN_EMAIL=admin@example.com
# Minimum 12 characters.
ADMIN_PASSWORD=
# Optional; defaults to "Administrator".
# ADMIN_NAME=Administrator
