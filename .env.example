# Copy to .env and fill in. .env is gitignored; never commit real values.
# Next.js loads .env files from the project ROOT (not from src/).

# ---------------------------------------------------------------------------
# Database — required
# ---------------------------------------------------------------------------
# MongoDB Atlas connection string. MUST include a database name path segment:
# without one the driver silently falls back to a database called "test".
# Named MONGO_URI (not MONGODB_URI) to match the key this project already uses.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/sendly?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Authentication — required
# ---------------------------------------------------------------------------
# Signs session cookies. Minimum 32 characters; better-auth refuses to start in
# production with its built-in default. Generate one with:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# Absolute base URL of this deployment. Used for cookie security decisions and
# auth callback URLs. http://localhost:3000 in development; the real origin in
# production (e.g. https://sendly.example.com).
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# debug | info | warn | error. Defaults to debug in development, info in production.
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Seed-only — read by `npm run db:seed-admin`, never by the web application
# ---------------------------------------------------------------------------
# There is no public sign-up. The first administrator is created by the seed
# script, which is idempotent and safe to re-run.
ADMIN_EMAIL=admin@example.com
# Minimum 12 characters.
ADMIN_PASSWORD=
# Optional; defaults to "Administrator".
# ADMIN_NAME=Administrator
